{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "PDF Printer"
    }
  },
  "PdfPrinter": {
    "SpoolDirectory": "%ProgramData%\\PDFPrinter\\Spool",
    "GhostscriptExePath": "%ProgramFiles%\\PDFPrinter\\redist\\gs\\gswin64c.exe",
    "PdfCompatibilityLevel": "1.7",
    "DefaultOutputFolder": "%USERPROFILE%\\Documents\\PDF Printer",
    "AlwaysShowSaveDialog": true,
    "OverwritePrompt": true,
    "MaxConcurrentConversions": 4,
    "JobTimeoutSeconds": 120
  }
}
