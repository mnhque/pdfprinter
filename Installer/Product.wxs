<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    PDF Printer 1.0.0 installer.

    Real installer behavior, not a placeholder:
      - Copies the Conversion Service, Config app, port monitor DLL, and
        (licensing-permitting) the staged Ghostscript redistributable.
      - Registers + starts PDFPrinterService as a Windows Service.
      - Runs custom actions (PDFPrinter.CustomActions.dll, see
        CustomActions/Install.cpp) that call the real Win32 Print Spooler
        APIs: AddPrinterDriver (referencing the inbox Microsoft XPS Document
        Writer v4 driver), AddMonitor (our pdfpm.dll), AddPort, AddPrinter
        ("PDF Printer"), and AddForm ("North America 4x6").
      - Registers the reciprocal Delete* calls as deferred custom actions
        that also run on uninstall/rollback, so no orphaned printer, port,
        monitor, driver, or form is left behind.
      - Because this is a real MSI, product registration under
        Programs and Features / Settings -> Apps -> Installed apps and its
        Uninstall button are automatic; no separate ARP registration step is
        required.
  -->

  <Package Name="PDF Printer"
           Manufacturer="PDF Printer Project"
           Version="1.0.0.0"
           UpgradeCode="8F2C7B3E-6A1D-4E2B-9C4A-1F7D2E5B9A01"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="PDF Printer 1.0.0 Setup" Manufacturer="PDF Printer Project" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of PDF Printer is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Only Print Spooler / device registration requires elevation; the
         printing operation itself (Config app usage, print jobs) never
         does. This package therefore always requests admin via the
         standard MSI elevation prompt at install/uninstall time only. -->
    <Property Id="ALLUSERS" Value="1" />

    <!-- Add Configuration\ConfigApp\Assets\app.ico (see Assets\README.txt), then
         uncomment the two lines below to show a custom icon in Installed apps.
    <Icon Id="AppIcon.ico" SourceFile="..\Configuration\ConfigApp\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    -->
    <Property Id="ARPHELPLINK" Value="https://example.invalid/pdfprinter/support" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PDFPrinter">
        <Directory Id="SERVICEDIR" Name="Service" />
        <Directory Id="CONFIGDIR" Name="Config" />
        <Directory Id="DRIVERDIR" Name="Driver" />
        <Directory Id="REDISTDIR" Name="redist">
          <Directory Id="GSDIR" Name="gs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuSubfolder" Name="PDF Printer" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PDFPRINTERDATA" Name="PDFPrinter">
        <Directory Id="SPOOLDIR" Name="Spool" />
      </Directory>
    </StandardDirectory>

    <!-- ================= Feature ================= -->
    <Feature Id="MainFeature" Title="PDF Printer" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigAppComponents" />
      <ComponentGroupRef Id="DriverComponents" />
      <ComponentGroupRef Id="GhostscriptComponents" />
      <ComponentRef Id="SpoolDirectoryComponent" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="MachineDefaultsRegistry" />
      <ComponentRef Id="PrinterRegistrationMarker" />
    </Feature>

    <!-- ================= Conversion Service ================= -->
    <ComponentGroup Id="ServiceComponents" Directory="SERVICEDIR">
      <Component Id="ServiceExe" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0001">
        <File Id="PDFPrinterServiceExe" Source="$(var.ServicePublishDir)\PDFPrinterService.exe" KeyPath="yes" />
        <File Id="PDFPrinterServiceDll" Source="$(var.ServicePublishDir)\PDFPrinterService.dll" />
        <File Id="PDFPrinterServiceJson" Source="$(var.ServicePublishDir)\appsettings.json" />
        <File Id="PDFPrinterServiceRuntimeConfig" Source="$(var.ServicePublishDir)\PDFPrinterService.runtimeconfig.json" />

        <ServiceInstall Id="PDFPrinterServiceInstall"
                         Name="PDFPrinterService"
                         DisplayName="PDF Printer Conversion Service"
                         Description="Converts PDF Printer print jobs (captured as XPS) to PDF and hands them off for saving. Required for PDF Printer to function."
                         Type="ownProcess"
                         Start="auto"
                         Account="LocalSystem"
                         ErrorControl="normal"
                         Vital="yes" />
        <ServiceControl Id="PDFPrinterServiceControl"
                         Name="PDFPrinterService"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- ================= Config App ================= -->
    <ComponentGroup Id="ConfigAppComponents" Directory="CONFIGDIR">
      <Component Id="ConfigAppExe" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0002">
        <File Id="PDFPrinterConfigExe" Source="$(var.ConfigAppPublishDir)\PDFPrinterConfig.exe" KeyPath="yes" />
        <File Id="PDFPrinterConfigDll" Source="$(var.ConfigAppPublishDir)\PDFPrinterConfig.dll" />
        <File Id="PDFPrinterConfigRuntimeConfig" Source="$(var.ConfigAppPublishDir)\PDFPrinterConfig.runtimeconfig.json" />
      </Component>
    </ComponentGroup>

    <!-- ================= Driver / Port Monitor ================= -->
    <ComponentGroup Id="DriverComponents" Directory="DRIVERDIR">
      <Component Id="PortMonitorDll" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0003">
        <File Id="PdfpmDll" Source="$(var.PortMonitorBinDir)\pdfpm.dll" KeyPath="yes" />
      </Component>
      <Component Id="PaperSizeXml" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0004">
        <File Id="NorthAmerica4x6Xml" Source="..\Driver\PaperSize\NorthAmerica4x6.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ================= Ghostscript redistributable ================= -->
    <!-- Staged by Scripts/package-ghostscript.ps1 before `wix build` runs;
         see README.md section 3 for the AGPL / commercial licensing note
         that must be resolved before public redistribution. -->
    <ComponentGroup Id="GhostscriptComponents" Directory="GSDIR">
      <Component Id="GhostscriptExe" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0005">
        <File Id="Gswin64cExe" Source="$(var.GhostscriptRedistDir)\gswin64c.exe" KeyPath="yes" />
      </Component>
      <Component Id="GhostscriptDll" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0006">
        <File Id="Gsdll64Dll" Source="$(var.GhostscriptRedistDir)\gsdll64.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ================= Spool directory (writable by all authenticated
         users so any signed-in user's print job can be captured; ACL is
         tightened to SYSTEM + Users-modify, not Everyone-full, via the
         custom action in Install.cpp) ================= -->
    <Component Id="SpoolDirectoryComponent" Directory="SPOOLDIR" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0007">
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\PDFPrinter" Name="SpoolDirCreated" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ================= Machine-wide default settings ================= -->
    <Component Id="MachineDefaultsRegistry" Directory="INSTALLFOLDER" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0008">
      <RegistryKey Root="HKLM" Key="Software\PDFPrinter\Settings">
        <RegistryValue Name="DefaultOutputFolder" Type="string" Value="%USERPROFILE%\Documents\PDF Printer" />
        <RegistryValue Name="DefaultPaperSize" Type="string" Value="Letter" />
        <RegistryValue Name="DefaultOrientation" Type="string" Value="Portrait" />
        <RegistryValue Name="AlwaysShowSaveDialog" Type="integer" Value="1" />
        <RegistryValue Name="AutoNumberFilenames" Type="integer" Value="1" />
        <RegistryValue Name="Version" Type="string" Value="1.0.0" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <!-- Marker component whose presence drives the printer-registration
         custom actions below (kept separate so repair/uninstall logic can
         key off it independently of file components). -->
    <Component Id="PrinterRegistrationMarker" Directory="INSTALLFOLDER" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B0009">
      <RegistryValue Root="HKLM" Key="Software\PDFPrinter" Name="PrinterRegistered" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ================= Start Menu ================= -->
    <Component Id="StartMenuShortcuts" Directory="ProgramMenuSubfolder" Guid="3B9E2E36-6E3F-4B7B-9B5D-9C6C1E9B000A">
      <Shortcut Id="ConfigAppShortcut"
                Name="PDF Printer Settings"
                Description="Configure PDF Printer defaults"
                Target="[CONFIGDIR]PDFPrinterConfig.exe"
                WorkingDirectory="CONFIGDIR" />
      <Shortcut Id="UninstallShortcut"
                Name="Uninstall PDF Printer"
                Description="Remove PDF Printer"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />
      <RemoveFolder Id="RemoveProgramMenuSubfolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\PDFPrinter" Name="StartMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ================= Custom Actions: real Print Spooler API calls =================

         Implemented in CustomActions/Install.cpp and Uninstall.cpp
         (PDFPrinter.CustomActions.dll), which call:
           AddPrinterDriverW  (referencing inbox "Microsoft XPS Document Writer v4")
           AddMonitorW        (registers pdfpm.dll under "PDF Printer Port Monitor")
           AddPortW / XcvDataW("AddPort")
           AddPrinterW        (creates the "PDF Printer" queue)
           AddFormW           (via RegisterPaperSize.cpp, "North America 4x6")
         and the Delete* counterparts, run as deferred custom actions with
         elevated (msidbCustomActionTypeNoImpersonate) execution since these
         require PRINTER_ACCESS_ADMINISTER / SERVER_ACCESS_ADMINISTER rights.
    -->
    <Binary Id="PDFPrinterCustomActionsDll" SourceFile="CustomActions\bin\x64\Release\PDFPrinter.CustomActions.dll" />

    <CustomAction Id="RegisterPrinterCA" BinaryRef="PDFPrinterCustomActionsDll"
                  DllEntry="RegisterPrinter" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UnregisterPrinterCA" BinaryRef="PDFPrinterCustomActionsDll"
                  DllEntry="UnregisterPrinter" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RegisterPrinterRollbackCA" BinaryRef="PDFPrinterCustomActionsDll"
                  DllEntry="UnregisterPrinter" Execute="rollback" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Rollback action must be scheduled immediately before the forward
           action so MSI can undo a half-completed printer registration if a
           later step in the transaction fails. -->
      <Custom Action="RegisterPrinterRollbackCA" Before="RegisterPrinterCA" Condition="NOT Installed" />
      <Custom Action="RegisterPrinterCA" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UnregisterPrinterCA" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Standard WiX-provided UI: license + directory + progress + finish,
         nothing exotic, so Next/Install/Finish works as any user expects. -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
