<Project Sdk="WixToolset.Sdk/4.0.4">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>PDF Printer Setup</OutputName>
    <DefineConstants>
      ConfigAppPublishDir=..\Configuration\ConfigApp\bin\Release\net8.0-windows\win-x64\publish;
      ServicePublishDir=..\PDFEngine\ConversionService\bin\Release\net8.0-windows\win-x64\publish;
      PortMonitorBinDir=..\Driver\PortMonitor\x64\Release;
      GhostscriptRedistDir=..\Scripts\redist\ghostscript
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.4" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CustomActions\PDFPrinter.CustomActions.vcxproj" />
  </ItemGroup>

</Project>
