<Window x:Class="PDFPrinter.ConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Printer" Height="420" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="PDF Printer" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Text=" 1.0.0" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,4" Foreground="Gray"/>
        </StackPanel>

        <GroupBox Header="Default output" Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <TextBlock Text="Save folder:"/>
                <DockPanel Margin="0,4,0,0">
                    <Button Content="Browse..." Width="90" DockPanel.Dock="Right" Click="BrowseFolder_Click"/>
                    <TextBox x:Name="OutputFolderBox" Margin="0,0,8,0"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Print defaults" Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Default paper size:" Width="140" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PaperSizeCombo">
                        <ComboBoxItem Content="Letter"/>
                        <ComboBoxItem Content="Legal"/>
                        <ComboBoxItem Content="A4"/>
                        <ComboBoxItem Content="A3"/>
                        <ComboBoxItem Content="A5"/>
                        <ComboBoxItem Content="Executive"/>
                        <ComboBoxItem Content="Tabloid"/>
                        <ComboBoxItem Content="Ledger"/>
                        <ComboBoxItem Content="B4"/>
                        <ComboBoxItem Content="B5"/>
                        <ComboBoxItem Content="North America 4x6"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Default orientation:" Width="140" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OrientationCombo">
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Landscape"/>
                    </ComboBox>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Behavior" Grid.Row="3" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <CheckBox x:Name="AlwaysShowSaveDialogCheck" Content="Always show Save As dialog when printing" Margin="0,0,0,6"/>
                <CheckBox x:Name="AutoNumberCheck" Content="Automatically number filenames to avoid overwriting"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="About" Width="80" Margin="0,0,8,0" Click="About_Click"/>
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
